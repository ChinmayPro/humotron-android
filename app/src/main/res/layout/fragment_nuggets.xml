<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:background="@color/black"
    tools:context=".ui.bioHack.NuggetsFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_biohack"
        app:layout_constraintTop_toTopOf="parent" />


    <com.yuyakaido.android.cardstackview.CardStackView
        android:id="@+id/card_stack_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="90dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDisLike"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="-24dp"
        android:background="@drawable/bg_round_green"
        android:backgroundTint="#131F1D"
        android:elevation="16dp"
        android:padding="16dp"
        android:src="@drawable/ic_close"
        app:tint="@color/white"
        app:layout_constraintEnd_toStartOf="@id/ivLike"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_stack_view" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivLike"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bg_like_button_ring"
        android:elevation="16dp"
        android:padding="18dp"
        android:src="@drawable/ic_onboard_heart"
        app:tint="@color/colorBgBtn"
        app:layout_constraintBottom_toBottomOf="@id/ivDisLike"
        app:layout_constraintEnd_toStartOf="@id/ivBookMark"
        app:layout_constraintStart_toEndOf="@id/ivDisLike"
        app:layout_constraintTop_toTopOf="@id/ivDisLike" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBookMark"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_round_green"
        android:backgroundTint="#131F1D"
        android:elevation="16dp"
        android:padding="16dp"
        android:src="@drawable/ic_bookmark"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/ivDisLike"
        app:layout_constraintEnd_toStartOf="@id/ivDetail"
        app:layout_constraintStart_toEndOf="@id/ivLike"
        app:layout_constraintTop_toTopOf="@id/ivDisLike" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivDetail"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_round_green"
        android:backgroundTint="#131F1D"
        android:elevation="16dp"
        android:padding="16dp"
        android:src="@drawable/ic_chevdown_profile"
        app:tint="#52BDC6"
        app:layout_constraintBottom_toBottomOf="@id/ivDisLike"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/ivBookMark"
        app:layout_constraintTop_toTopOf="@id/ivDisLike" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSwipeHint"
        style="@style/Text.12x.Manrope.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:text="Swipe ← dislike  •  → like  •  ↑ save  •  tap to read on"
        android:textColor="#526462"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLike" />

</androidx.constraintlayout.widget.ConstraintLayout>