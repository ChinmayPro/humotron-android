<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.EditCategoryPreferencesFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_2"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvStepLabel"
        style="@style/Text.12x.Manrope.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.08"
        android:text="STEP 1"
        android:textAllCaps="true"
        android:textColor="#7B9390"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvQuestionTitle"
        style="@style/Text.24x.Manrope.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:layout_constraintTop_toBottomOf="@id/tvStepLabel"
        tools:text="What areas of Metabolic Science do you want to focus on?" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvSelectedCount"
        style="@style/Text.14x.Manrope.Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="10dp"
        android:textColor="#C4F23E"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionTitle"
        tools:text="Selected 4 of 10 (min 1)" />

    <!-- Full-width Lime Green Progress Bar -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llProgressContainer"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="12dp"
        android:background="#1AFFFFFF"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedCount">

        <View
            android:id="@+id/vProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#C4F23E" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Sub-categories List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSubCategories"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintTop_toBottomOf="@id/llProgressContainer"
        tools:itemCount="5"
        tools:listitem="@layout/item_edit_category_subtag" />

    <!-- Bottom Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        style="@style/Text.16x.Manrope.Bold"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#C4F23E"
        android:text="Save  →"
        android:textColor="#0B1514"
        android:textSize="16sp"
        app:cornerRadius="27dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
