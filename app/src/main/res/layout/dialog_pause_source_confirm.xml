<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginHorizontal="28dp"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="22dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/manrope_bold"
        android:gravity="center"
        android:text="Pause this source?"
        android:textColor="#FFFFFF"
        android:textSize="17.5sp"
        android:textStyle="bold"
        app:fontFamily="@font/manrope_bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDialogSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/manrope_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:text="We'll stop using it for analysis until you resume."
        android:textColor="#9EAEAC"
        android:textSize="13.5sp"
        app:fontFamily="@font/manrope_regular" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_cancel"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            app:fontFamily="@font/manrope_bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_confirm"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Pause"
            android:textColor="#111827"
            android:textSize="14.5sp"
            app:fontFamily="@font/manrope_bold" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
