<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_bg_main_2">

    <!-- Header Container -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back_arrow">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/toolbar_title"
                    style="@style/ToolbarTitleStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book a scan"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnClose"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_close"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Step Progress Segments Bar -->
        <LinearLayout
            android:id="@+id/llProgressBar"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal" />

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutFooter"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Eyebrow Label -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStepEyebrow"
                    style="@style/Text.10x.Manrope.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.06"
                    android:text="STEP 5 OF 5 · REVIEW &amp; PAY"
                    android:textAllCaps="true"
                    android:textColor="#5FB7C4"
                    android:textSize="11sp" />

                <!-- Main Heading -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSelectHeading"
                    style="@style/Text.22x.Manrope.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Review &amp; confirm"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <!-- Subtitle -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSelectSubtitle"
                    style="@style/Text.14x.Manrope.Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="6dp"
                    android:text="A quick check before payment."
                    android:textColor="#9DACA9"
                    android:textSize="13.5sp" />

                <!-- Summary Container Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvSummaryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="22dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#8C080F10"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1AFFFFFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Row 1: Test -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <FrameLayout
                                android:id="@+id/flIconTest"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_btn_round_corner"
                                android:backgroundTint="#1F5FB7C4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_opt_flask"
                                    app:tint="#5FB7C4" />
                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvLabelTest"
                                style="@style/Text.10x.Manrope.Bold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:letterSpacing="0.04"
                                android:text="TEST"
                                android:textAllCaps="true"
                                android:textColor="#6F7E7D"
                                android:textSize="10sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/flIconTest"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvTestName"
                                style="@style/Text.14x.Manrope.Bold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Cardiac Biomarker Test"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@id/tvLabelTest"
                                app:layout_constraintTop_toBottomOf="@id/tvLabelTest" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvTestExtra"
                                style="@style/Text.12x.Manrope.Regular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="60+ biomarkers"
                                android:textColor="#859390"
                                android:textSize="12sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@id/tvLabelTest"
                                app:layout_constraintTop_toBottomOf="@id/tvTestName" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#1AFFFFFF" />

                        <!-- Row 2: Collection Method -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <FrameLayout
                                android:id="@+id/flIconMethod"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_btn_round_corner"
                                android:backgroundTint="#1F5FB7C4"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivMethodIcon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_grid_4"
                                    app:tint="#5FB7C4" />
                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvLabelMethod"
                                style="@style/Text.10x.Manrope.Bold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:letterSpacing="0.04"
                                android:text="COLLECTION METHOD"
                                android:textAllCaps="true"
                                android:textColor="#6F7E7D"
                                android:textSize="10sp"
                                app:layout_constraintEnd_toStartOf="@id/tvEditMethod"
                                app:layout_constraintStart_toEndOf="@id/flIconMethod"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvEditMethod"
                                style="@style/Text.12x.Manrope.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="4dp"
                                android:paddingVertical="2dp"
                                android:text="Edit"
                                android:textColor="#5FB7C4"
                                android:textSize="12sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvBookingTypeTitle"
                                style="@style/Text.14x.Manrope.Bold"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@id/tvLabelMethod"
                                app:layout_constraintTop_toBottomOf="@id/tvLabelMethod"
                                tools:text="At-home service" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvBookingTypeDesc"
                                style="@style/Text.12x.Manrope.Regular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#859390"
                                android:textSize="12sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="@id/tvLabelMethod"
                                app:layout_constraintTop_toBottomOf="@id/tvBookingTypeTitle"
                                tools:text="A professional visits your home to collect the sample." />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Row 3: Date & Time (BEFORE Address) -->
                        <LinearLayout
                            android:id="@+id/llDateTimeContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#1AFFFFFF" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <FrameLayout
                                    android:id="@+id/flIconDate"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_btn_round_corner"
                                    android:backgroundTint="#1F5FB7C4"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_clock"
                                        app:tint="#5FB7C4" />
                                </FrameLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvLabelDate"
                                    style="@style/Text.10x.Manrope.Bold"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:letterSpacing="0.04"
                                    android:text="DATE"
                                    android:textAllCaps="true"
                                    android:textColor="#6F7E7D"
                                    android:textSize="10sp"
                                    app:layout_constraintEnd_toStartOf="@id/ivEditTime"
                                    app:layout_constraintStart_toEndOf="@id/flIconDate"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/ivEditTime"
                                    style="@style/Text.12x.Manrope.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="2dp"
                                    android:text="Edit"
                                    android:textColor="#5FB7C4"
                                    android:textSize="12sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvSelectedDateTime"
                                    style="@style/Text.14x.Manrope.Bold"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="@id/tvLabelDate"
                                    app:layout_constraintTop_toBottomOf="@id/tvLabelDate"
                                    tools:text="Wed, 18 Jun" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvSelectedDateTimeExtra"
                                    style="@style/Text.12x.Manrope.Regular"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#859390"
                                    android:textSize="12sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="@id/tvLabelDate"
                                    app:layout_constraintTop_toBottomOf="@id/tvSelectedDateTime"
                                    tools:text="Morning · 8:00 – 11:00" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>

                        <!-- Row 4: Location / Address / Lab (AFTER Date) -->
                        <LinearLayout
                            android:id="@+id/llAddressContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#1AFFFFFF" />

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <FrameLayout
                                    android:id="@+id/flIconLocation"
                                    android:layout_width="34dp"
                                    android:layout_height="34dp"
                                    android:background="@drawable/bg_btn_round_corner"
                                    android:backgroundTint="#1F5FB7C4"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivLocationIcon"
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_opt_heart"
                                        app:tint="#5FB7C4" />
                                </FrameLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvAddressLabel"
                                    style="@style/Text.10x.Manrope.Bold"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="12dp"
                                    android:letterSpacing="0.04"
                                    android:text="AT HOME"
                                    android:textAllCaps="true"
                                    android:textColor="#6F7E7D"
                                    android:textSize="10sp"
                                    app:layout_constraintEnd_toStartOf="@id/ivEditAddress"
                                    app:layout_constraintStart_toEndOf="@id/flIconLocation"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/ivEditAddress"
                                    style="@style/Text.12x.Manrope.Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="2dp"
                                    android:text="Edit"
                                    android:textColor="#5FB7C4"
                                    android:textSize="12sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvAddressName"
                                    style="@style/Text.14x.Manrope.Bold"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="@id/tvAddressLabel"
                                    app:layout_constraintTop_toBottomOf="@id/tvAddressLabel"
                                    tools:text="Chinmay Bhatt" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvAddressDetails"
                                    style="@style/Text.12x.Manrope.Regular"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingExtra="2dp"
                                    android:textColor="#859390"
                                    android:textSize="12sp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="@id/tvAddressLabel"
                                    app:layout_constraintTop_toBottomOf="@id/tvAddressName"
                                    tools:text="113, Masthead House, 14 Rope Terrace, London, E16 2PH" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- Price Breakdown Pay Box -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvPayBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="22dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#0FC4F23E"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:contentPadding="15dp"
                    app:strokeColor="#33C4F23E"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Item Base Price Line -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPriceItemName"
                                style="@style/Text.13x.Manrope.Regular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="#859390"
                                android:textSize="12.5sp"
                                app:layout_constraintEnd_toStartOf="@id/tvPrice"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="At-home service" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvPrice"
                                style="@style/Text.14x.Manrope.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="£29.99" />

                        </androidx.constraintlayout.widget.ConstraintLayout>


                        <!-- Divider before total -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:background="#2EC4F23E" />

                        <!-- Total Line -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="11dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                style="@style/Text.13x.Manrope.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total to pay"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvTotalPrice"
                                style="@style/Text.22x.Manrope.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="£29.99" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sticky Footer Container -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_scan_footer_gradient"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmBooking"
            style="@style/Text.16x.Manrope.Bold"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/selector_btn_booking"
            android:text="Proceed to payment"
            android:textAllCaps="false"
            android:textColor="@color/selector_btn_text_booking" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvFooterNote"
            style="@style/Text.12x.Manrope.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Secure payment · cancel free up to 24h before"
            android:textColor="#859390"
            android:textSize="11.5sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
