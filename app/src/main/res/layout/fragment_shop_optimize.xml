<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:text="@string/optimize_title"
                android:textColor="@color/white50"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSubtitle"
                style="@style/Text.12x.Manrope.Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:text="@string/optimize_subtitle"
                android:textColor="@color/white50"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOptimize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="20dp"
                android:paddingBottom="40dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutScaffold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_scaffold_dashed_rect"
        android:paddingHorizontal="24dp"
        android:paddingVertical="30dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Badge -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/badgeScaffold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scaffold_badge"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_scaffold_node"
                app:tint="@color/lime" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/Text.10x.Manrope.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="Scaffold"
                android:textSize="9.5sp"
                android:fontFamily="@font/manrope_extra_bold"
                app:fontFamily="@font/manrope_extra_bold"
                android:textColor="@color/lime"
                android:letterSpacing="0.1" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Center Icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivScaffoldIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_scaffold_icon"
            android:padding="14dp"
            android:src="@drawable/ic_shop_optimize"
            app:tint="@color/lime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/badgeScaffold" />

        <!-- Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvScaffoldTitle"
            style="@style/Text.18x.Manrope.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Optimise"
            android:textColor="@color/white"
            android:fontFamily="@font/manrope_extra_bold"
            app:fontFamily="@font/manrope_extra_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivScaffoldIcon" />

        <!-- Description -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvScaffoldDesc"
            style="@style/Text.13x.Manrope.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Supplement and lifestyle suggestions tuned to the metrics that are drifting — each with a &quot;How does this help?&quot; explainer."
            android:textColor="@color/white50"
            app:layout_constraintTop_toBottomOf="@id/tvScaffoldTitle" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerScaffold"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/white05"
            app:layout_constraintTop_toBottomOf="@id/tvScaffoldDesc" />

        <!-- Footer -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvScaffoldFooter"
            style="@style/Text.12x.Manrope.Regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Awaiting brief · Optimise screen · supplements list + metric-linked rationale"
            android:textColor="@color/white30"
            android:textSize="11sp"
            app:layout_constraintTop_toBottomOf="@id/dividerScaffold" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layoutLoader"
        layout="@layout/layout_bar_loader"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
