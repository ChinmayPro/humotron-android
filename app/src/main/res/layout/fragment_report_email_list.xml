<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/ic_bg_main_2"
    tools:context=".ui.bloodreport.ReportEmailListFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_3" />

    <LinearLayout
        android:id="@+id/llHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <TextView
            android:id="@+id/tvTotalEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_extra_bold"
            android:text="0"
            android:textColor="@color/lime"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_extra_bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="@string/email_found"
            android:textColor="@color/white"
            android:textSize="23sp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSubheadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/manrope_medium"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/this_file_hasn_t_been_saved"
            android:textColor="@color/ink4"
            android:textSize="14.5sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_20dp"
        android:paddingBottom="100dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeadline"
        tools:itemCount="3"
        tools:listitem="@layout/item_email_found" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/llCount"
        app:srcCompat="@drawable/bg_black_gradient" />

    <LinearLayout
        android:id="@+id/llCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btnExtractMetrics"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSelectedCountNumber"
            style="@style/Text.16x.Manrope.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_regular"
            android:textColor="@color/ink4"
            android:textSize="11sp"
            tools:text="00" />

        <TextView
            android:id="@+id/tvSelectedCountText"
            style="@style/Text.16x.Manrope.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/manrope_regular"
            android:text="@string/pdfs_selected_for_data_parsing"
            android:textColor="@color/ink4"
            android:textSize="11sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExtractMetrics"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="@dimen/_20dp"
        android:layout_marginBottom="@dimen/_20dp"
        android:enabled="false"
        android:fontFamily="@font/manrope_bold"
        android:text="@string/extract_metrics"
        android:textAllCaps="false"
        android:textColor="#7d8a89"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/white10"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
