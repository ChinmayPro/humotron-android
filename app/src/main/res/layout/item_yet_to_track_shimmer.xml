<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    app:cardBackgroundColor="#8C080F10"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <View
            android:id="@+id/clSleepIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@color/white10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/ivSleepLock"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@color/white10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tvSleepTitle"
            android:layout_width="150dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:background="@color/white10"
            app:layout_constraintStart_toEndOf="@id/clSleepIcon"
            app:layout_constraintTop_toTopOf="@id/clSleepIcon" />

        <View
            android:id="@+id/tvSleepDesc"
            android:layout_width="220dp"
            android:layout_height="14dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:background="@color/white10"
            app:layout_constraintStart_toEndOf="@id/clSleepIcon"
            app:layout_constraintTop_toBottomOf="@id/tvSleepTitle" />

        <View
            android:id="@+id/btnSleepTrack"
            android:layout_width="110dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:background="@color/white10"
            app:layout_constraintStart_toEndOf="@id/clSleepIcon"
            app:layout_constraintTop_toBottomOf="@id/tvSleepDesc" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
