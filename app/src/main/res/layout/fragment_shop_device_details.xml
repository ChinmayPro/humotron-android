<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Sticky Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_back_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnCompare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:alpha="0.7"
                android:padding="8dp"
                android:src="@drawable/ic_shop_plus"
                android:visibility="gone"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnShare"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:alpha="0.7"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnLike"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:alpha="0.7"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_fav_checkbox"
                app:tint="@color/white" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layoutLoader"
        layout="@layout/layout_bar_loader"
        android:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNoData"
        style="@style/Text.16x.Manrope.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_data_found"
        android:textColor="@color/white50"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clTopBar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clTopBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="36dp">

            <!-- Hero Container matching HTML .phero flexbox layout -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Custom Radial Fading Grid View (exact match for .phero .grid2 from HTML) -->
                <com.humotron.app.view.HeroGridView
                    android:id="@+id/vHeroGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Center Radial Glow Aura Background (170dp x 170dp centered around icon) -->
                <View
                    android:id="@+id/vHeroGlow"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_hero_glow"
                    app:layout_constraintBottom_toBottomOf="@id/ivDeviceHeroIcon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivDeviceHeroIcon" />

                <!-- Center 80dp Device Hero Render Icon (Centered in space above pill) -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDeviceHeroIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_smart_scale_hero"
                    app:layout_constraintBottom_toTopOf="@id/vHeroPill"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- API ViewPager Gallery -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpImageGallery"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingHorizontal="40dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/vHeroPill"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Single Floating Lime Pill Line (Positioned at bottom of hero, matching HTML .phero .pill) -->
                <View
                    android:id="@+id/vHeroPill"
                    android:layout_width="46dp"
                    android:layout_height="9dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_hero_pill_glowing"
                    android:elevation="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Gallery Indicator Dots -->
                <LinearLayout
                    android:id="@+id/llIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Breadcrumbs -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBreadcrumb"
                style="@style/Text.12x.Manrope.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/ink3"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clHeroContainer"
                tools:text="HEALTH › WEIGHT SCALES" />

            <!-- Device Name Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDeviceName"
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="6dp"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/white"
                android:textSize="26sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvBreadcrumb"
                tools:text="Humotron Weight Scale" />

            <!-- Price Container -->
            <LinearLayout
                android:id="@+id/llPriceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvDeviceName">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvPrice"
                    style="@style/Text.18x.Manrope.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="£79.00" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvOnwardsLabel"
                    style="@style/Text.14x.Manrope.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/onwards"
                    android:textColor="@color/ink3"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Description -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDescription"
                style="@style/Text.14x.Manrope.Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/ink3"
                android:textSize="13.5sp"
                app:layout_constraintTop_toBottomOf="@id/llPriceContainer"
                tools:text="A smart bio-impedance scale that turns a 10-second step-on into a full-body composition read. Everything streams into Track the moment you weigh in." />

            <!-- Works with the Humotron App Chip -->
            <LinearLayout
                android:id="@+id/llWorksWithChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_works_with_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescription">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/lime" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvWorksWith"
                    style="@style/Text.12x.Manrope.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Works with the Humotron App"
                    android:textColor="@color/lime"
                    android:textSize="12sp"
                    tools:text="Works with the Humotron App" />
            </LinearLayout>

            <!-- Key Metrics Eyebrow Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvKeyMetricsLabel"
                style="@style/Text.12x.Manrope.Bold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.16"
                android:text="KEY METRICS · STREAMS INTO TRACK"
                android:textAllCaps="true"
                android:textColor="@color/eyebrow"
                android:textSize="10.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llWorksWithChip" />

            <!-- Key Metrics RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="22dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tvKeyMetricsLabel"
                tools:listitem="@layout/item_shop_metric" />

            <!-- Buy Now Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBuyNow"
                style="@style/Text.16x.Manrope.Bold"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_lime_pill"
                android:text="Buy Now"
                android:textAllCaps="false"
                android:textColor="#0D1618"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/rvMetrics" />

            <!-- Connect to app text -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvConnectApp"
                style="@style/Text.12x.Manrope.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/ink3"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBuyNow"
                tools:text="Already own this device? Connect it to the app ›" />

            <!-- Frequently Asked Questions Row Container -->
            <LinearLayout
                android:id="@+id/llFaqContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvConnectApp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_help_outline_24px"
                    app:tint="@color/ink4" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvFaq"
                    style="@style/Text.14x.Manrope.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Frequently Asked Questions"
                    android:textColor="@color/ink2"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_right_24px"
                    app:tint="@color/ink4" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
