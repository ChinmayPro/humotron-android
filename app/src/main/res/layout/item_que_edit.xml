<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardQuestionOne"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/hair"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/questionOneContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvQuestionOneLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_medium"
            android:textColor="@color/ink4"
            android:textSize="11.5sp"
            app:layout_constraintEnd_toStartOf="@id/btnEditQuestionOne"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Question 1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvQuestionOneTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_bold"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            app:layout_constraintEnd_toStartOf="@id/btnEditQuestionOne"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestionOneLabel"
            tools:text="How often do you feel overwhelmed?" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditQuestionOne"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@android:color/transparent"
            android:fontFamily="@font/manrope_bold"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:text="@string/edit_1"
            android:textColor="@color/lime"
            android:textSize="13sp"
            app:icon="@drawable/ic_chevron_right_24px"
            app:iconGravity="textEnd"
            app:iconPadding="3dp"
            app:iconTint="@color/lime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/dividerQuestionOne"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/hair"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuestionOneTitle" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvQuestionOneAnswer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope_bold"
            android:textColor="@color/booster_text_benefit"
            android:textSize="13.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerQuestionOne"
            tools:text="Rarely" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
