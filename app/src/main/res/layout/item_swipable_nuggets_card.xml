<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/selectableItemBackground"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#080F0E"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#080F0E"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            style="@style/Text.14x.Manrope.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Cell Functions - The Lifeline of Your Body"
            android:textColor="#5E6D6B"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent" />

        <com.humotron.app.view.StoryProgressView
            android:id="@+id/storyProgress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            app:progressColor="@color/colorBgBtn"
            app:segmentColor="#1F2E2C"
            app:segmentCornerRadius="2dp"
            app:segmentGap="8dp"
            app:segmentStrokeWidth="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAnecdoteCount"
            style="@style/Text.12x.Manrope.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:text="• Tap for next anecdote  •  1 / 5"
            android:textColor="#788887"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storyProgress" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCategory"
            style="@style/Text.12x.Manrope.SemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_border_amber"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAnecdoteCount"
            tools:text="Myth vs. Science" />

        <TextView
            android:id="@+id/tvPrimaryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLearning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textview1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/manrope_extra_bold"
            android:lineSpacingMultiplier="1.15"
            android:text="Did you know that consistent lack of sleep can increase the risk of mental health disorders?"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintBottom_toTopOf="@id/tvTags"
            app:layout_constraintTop_toBottomOf="@id/tvCategory" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/tvTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="36dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_opt_document"
                app:tint="#5E6D6B" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSource"
                style="@style/Text.14x.Manrope.Regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Fermented synergy RCT 2026"
                android:textColor="#5E6D6B"
                android:textSize="13sp" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl50"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <View
            android:id="@+id/nextStory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/gl50" />


        <View
            android:id="@+id/previousStory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="@id/gl50"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            tools:layout_editor_absoluteY="0dp" />

        <FrameLayout
            android:id="@+id/left_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15dp"
            android:layout_marginEnd="@dimen/_20dp"
            android:rotation="30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.humotron.app.view.BorderedTextView
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nope"
                android:textColor="#DC3C3C"
                app:borderColor="#DC3C3C"
                app:borderWidth="@dimen/_5dp"
                app:bottomPadding="@dimen/_10dp"
                app:cornerRadius="@dimen/_10dp"
                app:leftPadding="@dimen/_10dp"
                app:rightPadding="@dimen/_10dp"
                app:topPadding="@dimen/_10dp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/bottom_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="@dimen/_25dp"
            android:rotation="-45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.humotron.app.view.BorderedTextView
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Like"
                android:textColor="#0CBA0C"
                app:borderColor="#0CBA0C"
                app:borderWidth="@dimen/_4dp"
                app:bottomPadding="@dimen/_8dp"
                app:cornerRadius="@dimen/_10dp"
                app:leftPadding="@dimen/_20dp"
                app:rightPadding="@dimen/_20dp"
                app:topPadding="@dimen/_8dp" />

        </FrameLayout>


        <FrameLayout
            android:id="@+id/right_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20dp"
            android:layout_marginTop="@dimen/_25dp"
            android:rotation="-45"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.humotron.app.view.BorderedTextView
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Like"
                android:textColor="#0CBA0C"
                app:borderColor="#0CBA0C"
                app:borderWidth="@dimen/_4dp"
                app:bottomPadding="@dimen/_8dp"
                app:cornerRadius="@dimen/_10dp"
                app:leftPadding="@dimen/_20dp"
                app:rightPadding="@dimen/_20dp"
                app:topPadding="@dimen/_8dp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/top_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_20dp"
            android:layout_marginBottom="@dimen/_20dp"
            android:rotation="-45"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.humotron.app.view.BorderedTextView
                style="@style/Text.24x.Manrope.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Love"
                android:textColor="#3C3CFF"
                app:borderColor="#3C3CFF"
                app:borderWidth="@dimen/_5dp"
                app:bottomPadding="@dimen/_10dp"
                app:cornerRadius="@dimen/_10dp"
                app:leftPadding="@dimen/_10dp"
                app:rightPadding="@dimen/_10dp"
                app:topPadding="@dimen/_10dp" />

        </FrameLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>