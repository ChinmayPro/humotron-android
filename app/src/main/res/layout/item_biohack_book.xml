<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="22dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#080F10"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#12FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Top Section: Book Icon Box & Book Details -->
        <LinearLayout
            android:id="@+id/llTopSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Icon Box Container -->
            <FrameLayout
                android:id="@+id/flBookIconContainer"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_shop_device_icon_box"
                android:padding="14dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivBookSummary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shop_book_outline"
                    app:tint="@color/booster_accent_cool" />
            </FrameLayout>

            <!-- Book Info Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle"
                    style="@style/Text.15_5x.Manrope.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/textColorWhite"
                    tools:text="The Ketogenic Bible" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvAuthor"
                    style="@style/Text.10_5x.Manrope.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.04"
                    android:textColor="#859390"
                    tools:text="JASON FUNG" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTags"
                    style="@style/Text.10_5x.Manrope.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_shop_metric_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/booster_accent_cool"
                    tools:text="Fat Adaptation &amp; Ketosis" />

            </LinearLayout>
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#12FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/llTopSection" />

        <!-- Bottom Section: Price & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/vDivider">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPrice"
                style="@style/Text.16x.Manrope.ExtraBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textColorWhite"
                tools:text="£17.99" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Heart Container -->
                <FrameLayout
                    android:id="@+id/llFav"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_circle_icon"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivFav"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_fav"
                        app:tint="#7E8E8C" />
                </FrameLayout>

                <!-- Add Button -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btnAddToCart"
                    style="@style/Text.12_5x.Manrope.ExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_shop_add_btn"
                    android:paddingHorizontal="16dp"
                    android:gravity="center"
                    android:text="Add"
                    android:textColor="#0D1618"
                    android:drawableStart="@drawable/ic_shopping_cart"
                    android:drawablePadding="6dp"
                    android:drawableTint="#0D1618" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>