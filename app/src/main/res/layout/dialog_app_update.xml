<?xml version="1.0" encoding="utf-8"?>
<!-- HTML: .sheet (no overflow:hidden needed, border-radius clips naturally)
     .disc has position:absolute;inset:0 so it fills the FULL card ignoring padding.
     Content has its own padding. This gives the disc a tall-narrow oval = egg shape. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_update_dialog_lime"
    android:clipToOutline="true">

    <!-- .disc — fills FULL card (no padding), becomes egg-shaped oval -->
    <View
        android:id="@+id/vDisc"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_disc_lime"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Content wrapper with padding (like CSS padding on .sheet) -->
    <LinearLayout
        android:id="@+id/contentWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="46dp"
        android:paddingEnd="22dp"
        android:paddingBottom="42dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- .hero 88x88 — rocket icon + trail -->
        <FrameLayout
            android:id="@+id/flHeroDisc"
            android:layout_width="88dp"
            android:layout_height="88dp">

            <!-- .glyph.float — rocket icon -->
            <ImageView
                android:id="@+id/ivRocketIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="Update Rocket Icon"
                android:src="@drawable/ic_update_rocket"
                app:tint="@color/lime" />

        </FrameLayout>

        <!-- h3 — title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:textColor="@color/white"
            android:textSize="22sp"
            tools:text="A sharper Humotron is ready" />

        <!-- p — description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/manrope_medium"
            android:gravity="center"
            android:lineSpacingExtra="3.5dp"
            android:textColor="#9DACA9"
            android:textSize="14.5sp"
            tools:text="Faster readings and a cleaner recovery view.\nTakes about a minute." />


        <!-- .actions -->
        <TextView
            android:id="@+id/btnUpdateNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_btn_lime_pill"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Update now"
            android:textColor="#0D1618"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/btnMaybeLater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Maybe later"
            android:textColor="#859390"
            android:textSize="14.5sp" />

        <!-- Required subtext (hidden for optional, shown for required) -->
        <TextView
            android:id="@+id/tvRequiredSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:text="Required · takes ~1 min"
            android:textColor="#6F7E7D"
            android:textSize="10.5sp"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- .trail — spark dots (relative to the dialog root) -->
    <FrameLayout
        android:id="@+id/flSparkTrail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/spark1"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:translationX="-9dp"
            android:alpha="0"
            android:background="@drawable/bg_spark_dot" />

        <View
            android:id="@+id/spark2"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:alpha="0"
            android:background="@drawable/bg_spark_dot" />

        <View
            android:id="@+id/spark3"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:translationX="8dp"
            android:alpha="0"
            android:background="@drawable/bg_spark_dot" />

        <View
            android:id="@+id/spark4"
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:translationX="-3dp"
            android:alpha="0"
            android:background="@drawable/bg_spark_dot" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
