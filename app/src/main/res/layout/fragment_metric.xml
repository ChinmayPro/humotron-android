<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/ic_bg_main_2"
    tools:context=".ui.device.MetricFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_3" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLatestReading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_14dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:text="@string/your_latest_reading"
                android:textAlignment="center"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLatestReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_24dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ll_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvTemperatureValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_extra_bold"
                            android:text="00.00"
                            android:textColor="@color/white"
                            android:textSize="40sp" />

                        <TextView
                            android:id="@+id/tvUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_7dp"
                            android:fontFamily="@font/manrope_bold"
                            android:textColor="@color/ink3"
                            android:textSize="16sp"
                            tools:text="°C" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <TextView
                        android:id="@+id/tvTypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Temperature"
                        android:textColor="#cfdad8"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ll_temp" />

                    <TextView
                        android:id="@+id/tvDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text=""
                        android:textColor="@color/ink4"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTypeLabel" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/llSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Source: HumotronRing"
                        android:textColor="@color/white_50"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDateTime">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_regular"
                            android:text="@string/source"
                            android:textColor="@color/ink4"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSource"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="@font/manrope_regular"
                            android:textColor="@color/ink4"
                            android:textSize="11sp" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14dp"
                        app:cardBackgroundColor="@color/lime_18"
                        app:cardCornerRadius="9dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/llSource"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_regular"
                            android:paddingHorizontal="11dp"
                            android:paddingVertical="5dp"
                            android:text="OPTIMAL"
                            android:textColor="@color/lime"
                            android:textSize="11sp" />

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/track_trends"
                layout="@layout/layout_track_your_trends" />

            <com.humotron.app.view.ExpandableCardView
                android:id="@+id/ecv_what_is"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="32dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardDescription="@string/faq_a1_hrv"
                app:cardStrokeColor="@color/card_stroke"
                app:cardStrokeWidth="1dp"
                app:cardTitle="@string/what_is" />

            <com.humotron.app.view.ExpandableCardView
                android:id="@+id/ecv_why_it"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_14dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardDescription="@string/faq_a1_hrv"
                app:cardStrokeColor="@color/card_stroke"
                app:cardStrokeWidth="1dp"
                app:cardTitle="@string/why_it_matters_question" />

            <TextView
                android:id="@+id/tvDecodeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:text="@string/decode_your_reading"
                android:textAlignment="center"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvAiInsights"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="AI Insights"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="You don't have any insights for this time."
                    android:textColor="@color/white_50"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.yarolegovich.discretescrollview.DiscreteScrollView
                android:id="@+id/dsvInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:dsv_orientation="horizontal" />

            <TextView
                android:id="@+id/tvHowYouDoing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:text="@string/how_you_are_doing"
                android:textAlignment="center"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvMetricFreq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:id="@+id/tvAverageTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="0.0"
                    android:textColor="#FF3B30"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvUnitAvg"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvUnitAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°C"
                    android:textColor="@color/white_70"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvAverageTemp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvAverageTemp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/llMetricReadingSubText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMetricReadingSubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_red_indicator"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/_14dp"
                    tools:text="Test" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInfoAvg"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="@dimen/_3dp"
                    android:paddingBottom="0dp"
                    app:icon="@drawable/ic_info_24px"
                    app:iconSize="20dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMetricDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="@color/white_50"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvShortDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_red_rounded"
                android:minHeight="48dp"
                android:padding="@dimen/_12dp"
                android:textColor="#dfe9e3" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:gravity="center"
                android:text="What you can do\nabout it?"
                android:textAlignment="center"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Lifestyle Nudge"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoRecommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="You don't have any Recommendations for this time."
                    android:textColor="@color/white_50"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.yarolegovich.discretescrollview.DiscreteScrollView
                android:id="@+id/dsv_recommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_chat_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_24dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_chat_prompts" />

            <TextView
                android:id="@+id/tvSupplementsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_28dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:text="@string/suggested_supplements"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <com.yarolegovich.discretescrollview.DiscreteScrollView
                android:id="@+id/dsvSupplements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_supplements_chat_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_14dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_chat_prompts" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoSupplements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="You don't have any upplements for this time."
                    android:textColor="@color/white_60"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvRecipeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_28dp"
                android:fontFamily="@font/manrope_extra_bold"
                android:text="Suggested Recipe Bundles"
                android:textColor="@color/text_title_primary"
                android:textSize="22sp" />

            <com.yarolegovich.discretescrollview.DiscreteScrollView
                android:id="@+id/dsvRecipes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recipes_chat_prompts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_14dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_chat_prompts" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoRecipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="false"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:text="You don't have any recipes for this time."
                    android:textColor="@color/white_60"
                    android:textSize="14sp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_28dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Icon -->

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivBot"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_bot"
                        android:tint="#B7F36B"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Questions Title -->

                    <TextView
                        android:id="@+id/tvQuestions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Questions?"
                        android:textColor="@color/white_90"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivBot"
                        app:layout_constraintTop_toTopOf="@id/ivBot" />

                    <!-- Subtitle -->

                    <TextView
                        android:id="@+id/tvSubtitle1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Just ask our AI-powered assistant"
                        android:textColor="@color/white_60"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tvQuestions"
                        app:layout_constraintTop_toBottomOf="@id/tvQuestions" />

                    <!-- Start Chat Button -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartChat"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/start_chat"
                        android:textAllCaps="false"
                        android:textColor="#0d1618"
                        app:backgroundTint="@color/lime"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_arrow_right_alt_24px"
                        app:iconGravity="textEnd"
                        app:iconTint="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvSubtitle1" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSecondOpinion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_24dp"
                android:layout_marginTop="@dimen/_40dp"
                app:cardBackgroundColor="@color/card_bg_2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivDoctor"
                        android:layout_width="0dp"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_sample_doctor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/contentContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:padding="24dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ivDoctor">

                        <TextView
                            android:id="@+id/tvTitle3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Get a second opinion!"
                            android:textColor="@color/white_90"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Schedule a consultation call with an expert to discuss and get a second opinion on these recommendations."
                            android:textColor="@color/white_60"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvTitle3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConsult"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="20dp"
                            android:text="Schedule a Consultation"
                            android:textAllCaps="false"
                            android:textColor="#0d1618"
                            app:backgroundTint="@color/lime"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_arrow_right_alt_24px"
                            app:iconGravity="textEnd"
                            app:iconTint="#0d1618"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvGoDeeper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
