<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/ic_bg_main_2"
    tools:context=".ui.bloodreport.PDFReportListFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_3" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/header"
        tools:itemCount="3"
        tools:listitem="@layout/item_report" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvReports">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/_20dp">


            <!-- ============ dhero: source document summary ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDhero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="@color/dhero_bg"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/hair"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvReportFilename"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/_7dp"
                                android:fontFamily="@font/manrope_bold"
                                android:letterSpacing="-0.01"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                tools:text="complete-blood-count.pdf" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvSyncedStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/manrope_regular"
                                android:lineSpacingMultiplier="1.5"
                                android:textColor="@color/ink4"
                                android:textSize="11.5sp"
                                tools:text="Lab PDF · synced 12 Jun · 09:14" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            app:cardBackgroundColor="@color/cool_14"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_opt_document"
                                app:tint="@color/cool" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvExtractedSummary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/manrope_regular"
                            android:lineSpacingMultiplier="1.5"
                            android:text="@string/extracting_data_points"
                            android:textColor="@color/cool"
                            android:textSize="11.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDonwloadPDF"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="12dp"
                            android:backgroundTint="@color/white_6"
                            android:clickable="true"
                            android:focusable="true"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:icon="@drawable/ic_opt_document"
                            app:iconGravity="textEnd"
                            app:iconPadding="0dp"
                            app:iconSize="18dp"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Button.Circle"
                            app:strokeColor="@color/white10"
                            app:strokeWidth="1dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ "Extracted from your PDF" section label ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="18dp"
                android:paddingEnd="22dp"
                android:paddingBottom="4dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNextstepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_extra_bold"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/nextstep_title"
                    android:textColor="@color/nextstep_title"
                    android:textSize="16sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/manrope_semibold"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/nextstep_subtitle"
                    android:textColor="@color/ink4"
                    android:textSize="11.5sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <!-- Shimmer Loading View -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerReadings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:visibility="visible"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/shimmer_item_reading" />

                    <include layout="@layout/shimmer_item_reading" />

                    <include layout="@layout/shimmer_item_reading" />

                </LinearLayout>

            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ============ extracted markers list ============ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReadings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_reading"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>