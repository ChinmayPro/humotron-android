<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.3"
    app:shimmer_highlight_alpha="0.7"
    app:shimmer_duration="1200">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- Intro Skeleton -->
        <View
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_rounded_14"
            android:backgroundTint="@color/white_simmer" />

        <View
            android:layout_width="140dp"
            android:layout_height="22dp"
            android:layout_marginTop="13dp"
            android:background="@color/white_simmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@color/white_simmer" />

        <!-- Assure Bar Skeleton -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_assure_card"
            android:backgroundTint="@color/white_simmer" />

        <!-- Category Title Skeleton -->
        <View
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="24dp"
            android:background="@color/white_simmer" />

        <!-- Item Skeletons -->
        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cfg_card"
            android:backgroundTint="@color/white_simmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_cfg_card"
            android:backgroundTint="@color/white_simmer" />

        <!-- Category 2 Title Skeleton -->
        <View
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginTop="24dp"
            android:background="@color/white_simmer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cfg_card"
            android:backgroundTint="@color/white_simmer" />
    </androidx.appcompat.widget.LinearLayoutCompat>
</com.facebook.shimmer.ShimmerFrameLayout>
