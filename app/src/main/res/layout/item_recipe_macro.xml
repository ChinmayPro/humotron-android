<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minWidth="92dp"
    android:minHeight="72dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_recipe_card"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tvValue"
        style="@style/Text.16x.Manrope.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/white"
        tools:text="320 kcal" />

    <TextView
        android:id="@+id/tvSubValue"
        style="@style/Text.10x.Manrope.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/textColorMuted"
        android:visibility="gone"
        tools:text="(26% NRV)" />

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.10x.Manrope.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/textColorMuted"
        android:textAllCaps="true"
        android:singleLine="true"
        tools:text="ENERGY" />
</LinearLayout>
