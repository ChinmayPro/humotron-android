<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/ic_bg_main_2"
    tools:context=".ui.bloodreport.UploadReportIntroFragment">

    <include
        android:id="@+id/header"
        layout="@layout/layout_header_3" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20dp"
            android:paddingBottom="@dimen/_20dp">


            <!-- headline block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_extra_bold"
                    android:letterSpacing="-0.025"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/upload_headline"
                    android:textColor="@color/white"
                    android:textSize="23sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSubheadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/manrope_medium"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/upload_subheadline"
                    android:textColor="@color/ink2"
                    android:textSize="14.5sp" />

            </LinearLayout>

            <!-- ============ uphero: bordered card wrapping the animated custom view ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpHero"
                android:layout_width="match_parent"
                android:layout_height="172dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lime_18"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_uphero">

                    <!-- the entire animated scene (document scan + traveling dots +
                         pulsing device) lives in this one custom view. all of its
                         colors/durations/etc are attr-driven and it behaves like any
                         normal View for margin/padding. -->
                    <com.humotron.app.view.UploadHeroView
                        android:id="@+id/uploadHero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        app:autoStart="true"
                        app:breatheDurationMs="2200"
                        app:deviceColor="@color/cool"
                        app:deviceEndMargin="18dp"
                        app:documentColor="@color/lime"
                        app:documentCornerRadius="5dp"
                        app:dotCount="3"
                        app:dotDurationMs="2600"
                        app:scanDurationMs="2600"
                        app:showWaveIcon="true"
                        app:waveEndMargin="2dp" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ upchips row ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hair"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="11dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="12dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_clock"
                            app:tint="@color/lime" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"
                            android:minLines="2"
                            android:text="@string/upchip_tracked"
                            android:textColor="@color/stage_text"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hair"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="11dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="12dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_sparkle"
                            app:tint="@color/lime" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"
                            android:minLines="2"
                            android:text="@string/upchip_guidance"
                            android:textColor="@color/stage_text"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/card"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hair"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="11dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="12dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            app:srcCompat="@drawable/ic_shield_check"
                            app:tint="@color/lime" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:fontFamily="@font/manrope_bold"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"
                            android:minLines="2"
                            android:text="@string/upchip_private"
                            android:textColor="@color/stage_text"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ============ "Bring in your report" label ============ -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvAddcatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="11dp"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/addcat_label"
                android:textColor="@color/ink4"
                android:textSize="11sp" />

            <!-- ============ addcard: Upload a PDF ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUploadPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/hair"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/lime_13"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_upload"
                            app:tint="@color/lime" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_extra_bold"
                            android:text="@string/addcard_pdf_name"
                            android:textColor="@color/white"
                            android:textSize="15.5sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/manrope_regular"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/addcard_pdf_desc"
                            android:textColor="@color/ink3"
                            android:textSize="12.5sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                app:srcCompat="@drawable/ic_spark"
                                app:tint="@color/ink4" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/manrope_bold"
                                android:text="@string/addcard_pdf_badge"
                                android:textColor="@color/ink4"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="3dp"
                        app:srcCompat="@drawable/ic_chevron_right_24px"
                        app:tint="@color/addcard_chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ addcard: Import from email ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImportEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/hair"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/cool_13"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            app:srcCompat="@drawable/ic_email"
                            app:tint="@color/cool" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_extra_bold"
                            android:text="@string/addcard_email_name"
                            android:textColor="@color/white"
                            android:textSize="15.5sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/manrope_regular"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/addcard_email_desc"
                            android:textColor="@color/ink3"
                            android:textSize="12.5sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                app:srcCompat="@drawable/ic_spark"
                                app:tint="@color/ink4" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/manrope_bold"
                                android:text="@string/addcard_email_badge"
                                android:textColor="@color/ink4"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="3dp"
                        app:srcCompat="@drawable/ic_chevron_right_24px"
                        app:tint="@color/addcard_chevron" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ deep scan nudge ============ -->
            <LinearLayout
                android:id="@+id/llDeepScanNudge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nudge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingTop="13dp"
                android:paddingEnd="15dp"
                android:paddingBottom="13dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivNudgeIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_vial"
                    app:tint="@color/series" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNudgeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/nudge_deepscan_upload"
                    android:textColor="@color/ink2"
                    android:textSize="12.5sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivNudgeChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    app:srcCompat="@drawable/ic_chevron_right_24px"
                    app:tint="@color/ink4" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="26dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>