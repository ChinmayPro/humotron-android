<?xml version="1.0" encoding="utf-8"?>
<!-- CSS: .disc.tint-lime{background:radial-gradient(circle at 50% 40%,rgba(196,242,62,.22),rgba(196,242,62,.05));
     border:1px solid rgba(196,242,62,.3);} border-radius:50%
     This fills the entire card and becomes an oval/egg shape -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="50%"
        android:centerY="40%"
        android:gradientRadius="300dp"
        android:startColor="#38C4F23E"
        android:endColor="#0DC4F23E" />
    <stroke
        android:width="1dp"
        android:color="#4DC4F23E" />
</shape>
