<?xml version="1.0" encoding="utf-8"?>
<!-- Matches CSS .sheet with border-color:rgba(238,77,61,.22) for required update -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F5121C1E"
        android:endColor="#FA0A1213"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#38EE4D3D" />
</shape>
