<?xml version="1.0" encoding="utf-8"?>
<!-- Matches CSS .sheet: background linear-gradient(180deg, rgba(18,28,30,.96), rgba(10,18,19,.98));
     border:1px solid rgba(196,242,62,.16); border-radius:26px -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F5121C1E"
        android:endColor="#FA0A1213"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#29C4F23E" />
</shape>
