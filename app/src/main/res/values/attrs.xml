<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="StoryProgressView">
        <attr name="segmentCount" format="integer" /> <!-- Though we set this programmatically -->
        <attr name="segmentGap" format="dimension" />
        <attr name="segmentStrokeWidth" format="dimension" />
        <attr name="segmentCornerRadius" format="dimension" />
        <attr name="segmentColor" format="color" />
        <attr name="progressColor" format="color" />
    </declare-styleable>

    <declare-styleable name="BorderedTextView">
        <attr name="borderColor" format="color" />
        <attr name="cornerRadius" format="dimension" />
        <attr name="borderWidth" format="dimension" />
        <attr name="leftPadding" format="dimension" />
        <attr name="rightPadding" format="dimension" />
        <attr name="topPadding" format="dimension" />
        <attr name="bottomPadding" format="dimension" />
    </declare-styleable>

    <declare-styleable name="InfoCardView">
        <attr name="cardTitle" format="string" />
        <attr name="cardDescription" format="string" />
        <attr name="cardStrokeColor" format="color" />
        <attr name="cardStrokeWidth" format="dimension" />
        <attr name="cardBackgroundColor" format="color" />
    </declare-styleable>

    <declare-styleable name="LayeredCardView">

        <attr name="titleTextSize" format="dimension" />
        <attr name="descriptionTextSize" format="dimension" />
        <attr name="plusTextSize" format="dimension" />

        <attr name="titleTextColor" format="color" />
        <attr name="descriptionTextColor" format="color" />
        <attr name="plusTextColor" format="color" />

        <attr name="titleFontFamily" format="reference|string" />
        <attr name="descriptionFontFamily" format="reference|string" />
        <attr name="plusFontFamily" format="reference|string" />

    </declare-styleable>

    <declare-styleable name="VerticalGaugeView">

        <attr name="minValue" format="float" />
        <attr name="maxValue" format="float" />
        <attr name="step" format="float" />

        <attr name="primaryValue" format="float" />
        <attr name="secondaryValue" format="float" />
        <attr name="highlightTextValue" format="float" />

        <attr name="trackColor" format="color" />
        <attr name="fillColor" format="color" />
        <attr name="textColor" format="color" />
        <attr name="highlightTextColor" format="color" />
        <attr name="secondaryMarkerColor" format="color" />

        <attr name="maxTextSize" format="dimension" />
        <attr name="minTextSize" format="dimension" />

    </declare-styleable>

    <declare-styleable name="EcgWaveFormView">
        <attr name="ecgCornerRadius" format="dimension" />
        <attr name="strokeColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
        <attr name="gridColor" format="color" />
        <attr name="gridStrokeWidth" format="dimension" />
        <attr name="gridGap" format="dimension" />
        <attr name="backgroundColor" format="color" />
        <attr name="waveLineColor" format="color" />
        <attr name="waveStrokeWidth" format="dimension" />
        <attr name="waveScale" format="float" />
        <attr name="baselineOffset" format="dimension" />
        <attr name="showGrid" format="boolean" />
        <attr name="showBorder" format="boolean" />
        <attr name="autoScale" format="boolean" />
        <attr name="maxVisibleSamples" format="integer" />
    </declare-styleable>

    <declare-styleable name="OTPView">
        <attr name="android:inputType" />
        <attr name="android:importantForAutofill" />
        <attr name="android:autofillHints" />
        <attr name="otp_itemCount" format="integer" />
        <attr name="otp_showCursor" format="boolean" />
        <attr name="otp_underscoreCursor" format="boolean" />
        <attr name="otp_customCursor" format="reference" />
        <attr name="otp_itemWidth" format="dimension" />
        <attr name="otp_itemHeight" format="dimension" />
        <attr name="otp_cursorColor" format="color" />
        <attr name="otp_allcaps" format="boolean" />
        <attr name="otp_marginBetween" format="dimension" />
        <attr name="otp_ispassword" format="boolean" />

        <attr name="otp_textSize" format="dimension" />
        <attr name="otp_textColor" format="integer" />
        <attr name="otp_backgroundImage" format="reference" />
        <attr name="otp_Font" format="reference" />

        <attr name="otp_highlightedTextSize" format="dimension" />
        <attr name="otp_highlightedTextColor" format="integer" />
        <attr name="otp_highlightedBackgroundImage" format="reference" />
        <attr name="otp_highlightedFont" format="reference" />

        <attr name="otp_filledTextSize" format="dimension" />
        <attr name="otp_filledTextColor" format="integer" />
        <attr name="otp_filledBackgroundImage" format="reference" />
        <attr name="otp_filledFont" format="reference" />

    </declare-styleable>

    <declare-styleable name="ScanAnimationView">
        <attr name="scanColor" format="color" />
        <attr name="scanValue" format="string" />
        <attr name="scanValueSuffix" format="string" />
        <attr name="scanUnit" format="string" />
        <attr name="scanValueColor" format="color" />
        <attr name="scanUnitColor" format="color" />

        <attr name="scanProgress" format="float" />
        <attr name="scanProgressMargin" format="dimension" />

        <attr name="scanProgressBackgroundColor" format="color" />
    </declare-styleable>

    <!-- Shared by HdevRingView / HdevBandView / HdevScaleView / HdevCuffView -->
    <declare-styleable name="HdevAnimationView">
        <attr name="hdevColor" format="color" />
        <attr name="hdevProgress" format="float" />
    </declare-styleable>

    <!--BpMeasurementView-->
    <declare-styleable name="BpMeasurementView">
        <attr name="minValueBP" format="float" />
        <attr name="maxValueBP" format="float" />
        <attr name="stepBP" format="float" />
        <attr name="trackColorBP" format="color" />
        <!--  fillColor is split into two stops so it can reproduce the HTML's
                     linear-gradient(180deg, #9be84f, #5fbf6e) — a single color can't
                     express a gradient.  -->
        <attr name="fillColorStart" format="color" />
        <attr name="fillColorEnd" format="color" />
        <attr name="textColorBP" format="color" />
        <attr name="valueTextSize" format="dimension" />
        <attr name="stepTextSize" format="dimension" />
        <attr name="minMaxLabelTopMarginBP" format="dimension" />
        <attr name="minMaxLabelBottomMarginBP" format="dimension" />
        <attr name="barLabelGapBP" format="dimension" />
        <attr name="showValueLabel" format="boolean" />
        <attr name="showStepLabels" format="boolean" />
    </declare-styleable>

    <!-- ConicSweepView: rotating conic-gradient glow behind the progress ring -->
    <declare-styleable name="ConicSweepView">
        <attr name="accentColor" format="color" />
    </declare-styleable>

    <!-- RingProgressView: circular progress ring (.sc-prog) -->
    <declare-styleable name="RingProgressView">
        <attr name="trackColorRP" format="color" />
        <attr name="progressColorRP" format="color" />
        <attr name="ringStrokeWidth" format="dimension" />
        <attr name="progressPercent" format="float" />
    </declare-styleable>

    <!-- PulseRingView: single expanding / fading ring (.sc-pulse) -->
    <declare-styleable name="PulseRingView">
        <attr name="ringColor" format="color" />
        <attr name="baseRadius" format="dimension" />
        <attr name="pulseStrokeWidth" format="dimension" />
    </declare-styleable>

    <!-- NodeGraphView: hex spoke diagram with breathing nodes (.sc-graph) -->
    <declare-styleable name="NodeGraphView">
        <attr name="nodeColor" format="color" />
        <attr name="graphAccentColor" format="color" />
        <attr name="centerDotSize" format="dimension" />
        <attr name="centerDotColor" format="color" />
    </declare-styleable>

    <declare-styleable name="RoundCornerView">
        <attr name="appCornerRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ProcessingView">

        <!-- ============ ART / CENTER MOTIF ============ -->
        <!-- Accent color used for orbit lines, dots, pulse rings, and the solid center disc -->
        <attr name="pv_accentColor" format="color" />
        <!-- Override just the orbit line color (defaults to accentColor @ ~50% alpha) -->
        <attr name="pv_lineColor" format="color" />
        <!-- Override just the small orbit-node dot color (defaults to pv_chipTextColor-ish grey) -->
        <attr name="pv_dotColor" format="color" />
        <!-- Solid filled center disc color (defaults to accentColor) -->
        <attr name="pv_centerCircleColor" format="color" />
        <!-- Icon drawn inside the center disc. If omitted, a built-in heart glyph is drawn. -->
        <attr name="pv_centerIcon" format="reference" />
        <!-- Tint applied to the center icon (defaults to a dark ink color, like the original) -->
        <attr name="pv_centerIconTint" format="color" />
        <!-- Icon size as a fraction of the center disc diameter, 0..1 (default 0.55) -->
        <attr name="pv_centerIconSizeRatio" format="float" />

        <!-- Diameter of the square art area (the hexagon+rings+labels region) -->
        <attr name="pv_artSize" format="dimension" />
        <!-- Radius from center to each of the 6 orbit nodes -->
        <attr name="pv_orbitRadius" format="dimension" />
        <!-- Radius from center to each of the 6 floating label chips -->
        <attr name="pv_labelRadius" format="dimension" />
        <!-- Radius of the small pulsing dot at each orbit node -->
        <attr name="pv_dotRadius" format="dimension" />
        <!-- Radius of the solid center disc -->
        <attr name="pv_centerCircleRadius" format="dimension" />

        <!-- ============ LABEL CHIPS (the 6 floating pills, e.g. "Activity", "Stress"...) ============ -->
        <!-- String-array resource with the chip labels, e.g. @array/processing_labels -->
        <attr name="pv_labels" format="reference" />
        <attr name="pv_chipBackgroundColor" format="color" />
        <attr name="pv_chipStrokeColor" format="color" />
        <attr name="pv_chipStrokeWidth" format="dimension" />
        <attr name="pv_chipTextColor" format="color" />
        <attr name="pv_chipTextSize" format="dimension" />
        <attr name="pv_chipCornerRadius" format="dimension" />
        <attr name="pv_chipHorizontalPadding" format="dimension" />
        <attr name="pv_chipVerticalPadding" format="dimension" />

        <!-- ============ TITLE ("Building your picture") ============ -->
        <attr name="pv_title" format="string" />
        <attr name="pv_titleColor" format="color" />
        <attr name="pv_titleTextSize" format="dimension" />

        <!-- ============ SUBTITLE (cycling status line under the title) ============ -->
        <!-- Single static subtitle -->
        <attr name="pv_subtitle" format="string" />
        <!-- OR a string-array resource to crossfade-cycle through, e.g. @array/processing_subtitles -->
        <attr name="pv_subtitles" format="reference" />
        <attr name="pv_subtitleColor" format="color" />
        <attr name="pv_subtitleTextSize" format="dimension" />
        <!-- How long each subtitle is shown before crossfading to the next, in ms -->
        <attr name="pv_subtitleCycleIntervalMs" format="integer" />

        <!-- ============ FOOTER (small disclaimer row with icon) ============ -->
        <attr name="pv_footerText" format="string" />
        <attr name="pv_footerTextColor" format="color" />
        <attr name="pv_footerTextSize" format="dimension" />
        <!-- Icon drawn to the left of the footer text. If omitted, a built-in shield-check glyph is drawn. -->
        <attr name="pv_footerIcon" format="reference" />
        <attr name="pv_footerIconColor" format="color" />

        <!-- ============ SPACING (all support margin-like control between blocks) ============ -->
        <attr name="pv_maxContentWidth" format="dimension" />
        <attr name="pv_spacingArtToTitle" format="dimension" />
        <attr name="pv_spacingTitleToSubtitle" format="dimension" />
        <attr name="pv_spacingSubtitleToFooter" format="dimension" />

        <!-- ============ ANIMATION ============ -->
        <attr name="pv_autoStart" format="boolean" />
        <attr name="pv_repeatEnabled" format="boolean" />

    </declare-styleable>

    <declare-styleable name="UploadHeroView">
        <!-- color of the document outline, its content lines, and the scanline -->
        <attr name="documentColor" format="color" />
        <!-- color of the device ring, the pulsing core, and the waveform glyph -->
        <attr name="deviceColor" format="color" />
        <!-- corner radius of the document rectangle -->
        <attr name="documentCornerRadius" format="dimension" />
        <!-- how many traveling dots to draw between the document and the device (1-3 in the original) -->
        <attr name="dotCount" format="integer" />
        <!-- whether to draw the small waveform glyph inside the pulsing core -->
        <attr name="showWaveIcon" format="boolean" />
        <!-- duration of one scanline sweep, ms — matches @keyframes upscan (2600ms) -->
        <attr name="scanDurationMs" format="integer" />
        <!-- duration of one dot's travel, ms — matches @keyframes updot (2600ms) -->
        <attr name="dotDurationMs" format="integer" />
        <!-- duration of one core breathe cycle, ms — matches @keyframes hbreathe (2200ms) -->
        <attr name="breatheDurationMs" format="integer" />
        <!-- whether animations start automatically when the view attaches to the window -->
        <attr name="autoStart" format="boolean" />
        <attr name="waveEndMargin" format="dimension" />
        <attr name="deviceEndMargin" format="dimension" />
    </declare-styleable>
</resources>
